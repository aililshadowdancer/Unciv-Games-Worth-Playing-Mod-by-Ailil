{
  "fast": true,
  "combineSubdirectories": true,
  "flattenPaths": true,
  "premultiplyAlpha": false,
  "useIndexes": false,
  "maxWidth": 2048,
  "maxHeight": 2048,
  "paddingX": 8,
  "paddingY": 8,
  "duplicatePadding": true,
  "stripWhitespaceX": false,
  "stripWhitespaceY": false,
  "alias": false,
  "format": "RGBA8888",
  "filterMin": "Linear",
  "filterMag": "Linear"
}
